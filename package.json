{
  "name": "sp-gamification",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @sp-gamification/core test && pnpm --filter @sp-gamification/sp-plugin test",
    "package:plugin": "pnpm --filter @sp-gamification/sp-plugin package",
    "package:pet": "pnpm --filter @sp-gamification/desktop-pet package:win",
    "package:all": "pnpm package:plugin && pnpm package:pet",
    "dev:pet": "pnpm --filter @sp-gamification/desktop-pet dev"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
