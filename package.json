{
  "name": "sppet",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @sppet/core test && pnpm --filter @sppet/sp-plugin test && pnpm --filter @sppet/website test",
    "package:plugin": "pnpm --filter @sppet/sp-plugin package",
    "package:pet": "pnpm --filter @sppet/desktop-pet package:win",
    "package:all": "pnpm package:plugin && pnpm package:pet",
    "dev:pet": "pnpm --filter @sppet/desktop-pet dev"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
