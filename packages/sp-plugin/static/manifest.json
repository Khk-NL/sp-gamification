{
  "name": "SPPet：学习与冒险",
  "id": "sp-gamification",
  "manifestVersion": 1,
  "version": "0.3.2",
  "minSupVersion": "18.21.2",
  "description": "把任务与专注转化为委托、养成、回合制战斗和桌宠反馈。",
  "author": "SCSldr",
  "hooks": [
    "taskComplete",
    "taskUpdate",
    "taskCreated",
    "currentTaskChange",
    "finishDay",
    "persistedDataChanged",
    "languageChange"
  ],
  "permissions": [
    "getTasks",
    "persistDataSynced",
    "loadSyncedData",
    "showIndexHtmlAsView",
    "showSnack",
    "notify",
    "http"
  ],
  "allowedHosts": ["sppet.scsldr.cn"],
  "i18n": { "languages": ["en", "zh"] },
  "iFrame": true,
  "sidePanel": true,
  "type": "standard",
  "assets": [],
  "icon": "icon.svg"
}
